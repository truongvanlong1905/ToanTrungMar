{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Google Ads Sync Input Fixture — Module 02 Toàn Trung",
  "description": "File mẫu đầu vào (input) dùng để cấu hình tham số đồng bộ, gửi request API hoặc chạy CLI runner",
  "syncConfiguration": {
    "provider": "mock",
    "accountPropertyId": "GADS-SYNTH-MOCK-01",
    "customerId": "1234567890",
    "loginCustomerId": "9876543210",
    "runType": "light",
    "startDate": "2026-11-10",
    "endDate": "2026-11-11",
    "currencyCode": "VND"
  },
  "apiPayloadExamples": {
    "triggerSyncPost": {
      "endpoint": "/api/v1/tracking/sync",
      "method": "POST",
      "description": "Payload gửi lên API để kích hoạt phiên đồng bộ thủ công hoặc replay",
      "headers": {
        "Content-Type": "application/json",
        "x-csrf-token": "<CSRF_TOKEN_FROM_SESSION>"
      },
      "body": {
        "platform": "google_ads",
        "runType": "light",
        "forceMock": true,
        "startDate": "2026-11-10",
        "endDate": "2026-11-11"
      }
    },
    "triggerSyncFullPost": {
      "endpoint": "/api/v1/tracking/sync",
      "method": "POST",
      "description": "Payload kích hoạt đồng bộ đầy đủ 30 ngày",
      "body": {
        "platform": "google_ads",
        "runType": "full",
        "forceMock": true
      }
    },
    "queryMetricsGet": {
      "endpoint": "/api/v1/tracking/metrics",
      "method": "GET",
      "description": "Tham số query đọc số liệu chuẩn hóa cho Dashboard M02/M04",
      "queryParams": {
        "platform": "google_ads",
        "grain": "campaign",
        "metricDateFrom": "2026-11-01",
        "metricDateTo": "2026-11-11",
        "limit": 50,
        "offset": 0
      }
    },
    "queryKeywordMetricsGet": {
      "endpoint": "/api/v1/tracking/metrics",
      "method": "GET",
      "description": "Tham số query đọc số liệu từ khóa cho Module 03 (SEO & Ads)",
      "queryParams": {
        "platform": "google_ads",
        "grain": "keyword",
        "metricDateFrom": "2026-11-01",
        "metricDateTo": "2026-11-11",
        "limit": 100
      }
    }
  },
