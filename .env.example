# Toàn Trung V2 — Environment Configuration Template
# Put real values in ignored local .env files or the deployment secret store.
# Never add secrets to NEXT_PUBLIC_* variables or commit credentials.

# 1. Database & Private Storage (Production: use absolute paths on persistent volume)
DATABASE_URL="file:./packages/database/prisma/independent_v2.db"
STORAGE_ROOT="./storage_independent_v2"
NODE_ENV="development"
PUBLIC_WEBHOOK_BASE_URL=""

# 2. Security Secrets & Credential Vault (Minimum 32 random bytes in production)
SESSION_SECRET="replace-with-at-least-32-bytes-random-secret-key"
VAULT_MASTER_KEY="replace-with-at-least-32-bytes-random-vault-key"
WEBHOOK_SECRET=""
WEBHOOK_SHARED_SECRET=""

# 3. Initial Seed Guard (Set SKIP_SEED_ACCOUNTS="true" on production after initial setup)
SKIP_SEED_ACCOUNTS="false"
SEED_DEV_PASSWORD=""

# 4. AI Studio Integration (Zero-PII Gateway)
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"

# 5. Google OAuth 2.0 Credentials (Private server secrets)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
