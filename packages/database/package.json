{
  "name": "@toantrung/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "schema": "prisma"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma && prisma generate --schema=prisma-postgres",
    "db:generate:postgres": "prisma generate --schema=prisma-postgres",
    "db:migrate:deploy": "node scripts/migrate-deploy.js",
    "db:push": "prisma db push --schema=prisma",
    "db:seed": "node scripts/seed.js",
    "db:seed:catalog": "node scripts/seed.js --catalog-only",
    "db:seed:demo": "node scripts/seed.js --demo",
    "db:provision:admin": "node scripts/provision-admin.js"
  }
}
