# File mẫu biến môi trường đầu vào (Environment Input) cho Google Ads API
# Module 02: Tracking và đồng bộ số liệu đa kênh (02-tracking-sync)

# 1. Chế độ hoạt động của Provider
# - 'mock': Chạy với bộ giả lập dữ liệu tổng hợp (mặc định, không cần Cloud)
# - 'live': Kết nối trực tiếp Google Ads API của Google Cloud
GOOGLE_ADS_PROVIDER="mock"

# 2. Định danh tài khoản Google Ads
# Customer ID gồm 10 chữ số (nhập liền nhau hoặc có dấu gạch ngang: 123-456-7890)
GOOGLE_ADS_CUSTOMER_ID="1234567890"

# (Tùy chọn) Mã tài khoản quản lý MCC nếu tài khoản khách hàng được quản lý qua MCC
GOOGLE_ADS_LOGIN_CUSTOMER_ID="9876543210"

# 3. Thông tin xác thực Google Cloud OAuth 2.0 / Service Account
# Tạo trong Google Cloud Console > APIs & Services > Credentials
# Yêu cầu Google Ads API đã bật và Cloud Project đạt mức Explorer Access trở lên
GOOGLE_ADS_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_ADS_CLIENT_SECRET="your-client-secret"
GOOGLE_ADS_REFRESH_TOKEN="your-oauth-refresh-token"

# 4. Phiên bản Google Ads REST API (Mặc định: v18)
GOOGLE_ADS_API_VERSION="v18"
